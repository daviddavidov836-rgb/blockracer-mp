{
  "name": "blockracer-mp",
  "main": "index.js",
  "compatibility_date": "2025-09-01",
  "rules": [ { "type": "Text", "globs": ["**/*.html"], "fallthrough": true } ],
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Hub", "Room"] } ]
}
